{
  "name": "@izumisy/deps2changesets",
  "version": "0.5.0",
  "private": false,
  "description": "CLI tool to automatically generate changesets from dependency changes in Git commits",
  "keywords": [
    "changesets",
    "cli",
    "dependabot",
    "dependencies",
    "monorepo"
  ],
  "license": "MIT",
  "author": "",
  "repository": "https://github.com/IzumiSy/deps2changesets.git",
  "bin": {
    "deps2changesets": "./dist/cli.mjs",
    "deps2cs": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/cli.mjs",
  "scripts": {
    "build": "tsdown",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@manypkg/get-packages": "^3.1.0",
    "consola": "^3.4.2",
    "gunshi": "^0.27.5",
    "simple-git": "^4.0.1"
  },
  "devDependencies": {
    "@changesets/write": "^1.0.1",
    "@types/node": "^26.6.4",
    "memfs": "^4.79.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.6.0"
}
